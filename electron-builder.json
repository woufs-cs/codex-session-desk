{
  "appId": "io.github.woufs-cs.sessiondesk",
  "productName": "Session Desk",
  "executableName": "SessionDesk",
  "directories": {
    "output": "dist/single-exe"
  },
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "signAndEditExecutable": false
  },
  "portable": {
    "artifactName": "SessionDesk-${version}-portable-win-x64.exe",
    "requestExecutionLevel": "user",
    "unpackDirName": true
  },
  "publish": null,
  "nsis": {
    "artifactName": "SessionDesk-${version}-Setup-win-x64.exe",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Session Desk",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": false
  }
}
