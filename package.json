{
  "name": "codex-session-desk",
  "version": "0.16.0-beta.3",
  "private": true,
  "description": "Local-first Codex conversation browser and peer snapshot synchronization",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --max-old-space-size=192 --test --test-concurrency=1 test/*.test.cjs",
    "check": "node --check core.cjs && node --check main.cjs && node --check desktop-ui.js",
    "dist:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-single-exe.ps1",
    "dist:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-single-exe.ps1 -Target nsis",
    "dist:mac": "node scripts/build-mac.cjs"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/woufs-cs/codex-session-desk.git"
  },
  "engines": {
    "node": ">=24"
  }
}
